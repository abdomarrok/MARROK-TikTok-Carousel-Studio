# GEMINI_API_KEY: Primary server-side Gemini API key for /api/generate, /api/refine-slide, and /api/generate-image.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_BACKUP / GEMINI_API_KEY_2: Optional second Gemini API key from another Google account.
# Automatically used when the primary key hits 429 rate limits or quota exhaustion.
GEMINI_API_KEY_BACKUP=""

# GEMINI_API_KEYS: Optional comma-separated pool of additional Gemini API keys for automatic failover rotation.
GEMINI_API_KEYS=""

# FREE_BACKUP_AI_ENABLED: Enable zero-key Pollinations AI fallback (text + 9:16 flux images) before going offline (default: true).
FREE_BACKUP_AI_ENABLED="true"

# FREE_TEXT_BACKUP_MODELS: Comma-separated zero-key Pollinations OpenAI-compatible backup models.
FREE_TEXT_BACKUP_MODELS="openai,mistral,llama"

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# ALLOWED_ORIGIN: Optional strict CORS origin (e.g. "https://marrok.studio"). Defaults to "*" in dev.
ALLOWED_ORIGIN="*"

# API_SHARED_SECRET: Optional shared secret header (x-api-secret) required when using the server GEMINI_API_KEY.
API_SHARED_SECRET=""

# RATE_LIMIT_RPM: Per-IP requests per minute cap on AI generation endpoints (default: 30).
RATE_LIMIT_RPM="30"

# GEMINI_GENERATION_MODELS: Comma-separated ordered model cascade for /api/generate and /api/refine-slide.
GEMINI_GENERATION_MODELS="gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest"

# GEMINI_IMAGE_MODELS: Comma-separated ordered model cascade for /api/generate-image.
GEMINI_IMAGE_MODELS="gemini-nano-banana-2.1,gemini-3.1-flash-lite-image"

# OPTIONAL VERCEL CLOUD PERSISTENCE (Vercel KV / Upstash Redis):
# Connect an Upstash Redis / Vercel KV store in your Vercel project to persist saved valid posts across all devices.
# Even without these variables, the app automatically persists validated posts via Browser IndexedDB + /tmp sync.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""


